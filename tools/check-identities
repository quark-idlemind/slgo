#!/bin/sh
# check-identities looks for real people and places in what is about to be
# committed.
#
# Most of what is written down in this repository was measured on a live grid,
# standing next to other people's homes, and the output that carries a
# measurement carries their names with it: "parcel --region" lists the
# neighbours' parcels, a landmark listing says where somebody has been,
# "objects --owner" names people.  The rule is in CLAUDE.md; this is the check
# that catches the rule being broken by accident.
#
# The list of real names is NOT in this repository, because writing them down
# here is the thing being prevented.  It lives on the machine that did the
# measuring:
#
#     ~/.config/slgo/identities.tsv        real<TAB>replacement, # for comments
#
# or wherever SLGO_IDENTITIES points.  Somebody who has never touched the live
# grid has no such file and nothing to hide, so a missing list is not an error:
# the check says so and passes.
#
# Usage:
#     tools/check-identities                 what is staged for commit
#     tools/check-identities --worktree      what is changed but not staged
#     tools/check-identities --all           every tracked file, and the tags
#     tools/check-identities FILE...         the files named, which must be
#                                            readable files in this checkout
#     tools/check-identities --message FILE  a commit message, before it is made
#     tools/check-identities --install-hook  run it before every commit
#
# Every check runs, whatever an earlier one found: it prints the file and line
# of everything it finds, and what to write instead, and the exit status is 1
# at the end if any of them found something, 0 if none did, and 2 when it
# could not look: a named file it cannot read, or an option it does not
# know.  The checks are:
# a compiled binary, an image carrying metadata (tools/scan-images), a
# network address, a 128-bit identifier that does not carry the signature
# (tools/scan-ids, which doc/identities.md describes), a grid square that is
# not marked, a name that is not on tools/known-names, and
# the list of real names above.  Only the last needs a list kept off the tree;
# the others need nothing.

set -eu

map=${SLGO_IDENTITIES:-$HOME/.config/slgo/identities.tsv}
root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

if [ "${1:-}" = "--install-hook" ]; then
	hooks=$(git rev-parse --git-dir)/hooks
	for h in pre-commit commit-msg; do
		if [ -e "$hooks/$h" ] && ! grep -q check-identities "$hooks/$h" 2>/dev/null; then
			printf 'a %s hook already exists and does not call this:\n  %s\n' "$h" "$hooks/$h" >&2
			exit 1
		fi
	done
	cat > "$hooks/pre-commit" <<'HOOK'
#!/bin/sh
exec "$(git rev-parse --show-toplevel)/tools/check-identities"
HOOK
	cat > "$hooks/commit-msg" <<'HOOK'
#!/bin/sh
exec "$(git rev-parse --show-toplevel)/tools/check-identities" --message "$1"
HOOK
	chmod +x "$hooks/pre-commit" "$hooks/commit-msg"
	echo "installed $hooks/pre-commit and $hooks/commit-msg"
	exit 0
fi

# The list of real names is the one check that needs a file kept off the
# tree.  Without it that check says so and the rest run as they always do.
haslist=1
if [ ! -r "$map" ]; then
	haslist=0
	echo "check-identities: no list at $map, so no real names are checked for"
	echo "  (that is the ordinary case for anybody who has not measured on the grid;"
	echo "  everything else is checked all the same)"
fi

failed=0

# What to look at.  Staged additions by default, because that is what a commit
# is about to make public.
scope=${1:---staged}
case "$scope" in
--staged)   files=$(git diff --cached --name-only --diff-filter=ACMR) ;;
--worktree) files=$(git diff --name-only --diff-filter=ACMR) ;;
--all)      files=$(git ls-files) ;;
--message)  files=""; msgfile=${2:?check-identities: --message wants a file} ;;
-*)         echo "check-identities: no such option $scope" >&2; exit 2 ;;
*)          files=$*; named=1 ;;
esac

# A file named on the command line has to be one this can read, in this
# checkout: one that is not -- a typo, or a path outside the checkout --
# would otherwise be skipped and read as nothing real found.  An absolute
# path inside the checkout is taken as the same file.
if [ "${named:-0}" = 1 ]; then
	rel="" bad=0
	for f in $files; do
		case "$f" in "$root"/*) f=${f#"$root"/} ;; esac
		if [ ! -f "$root/$f" ] || [ ! -r "$root/$f" ]; then
			echo "check-identities: $f is not a readable file in this checkout ($root)" >&2
			bad=1
		fi
		rel="$rel $f"
	done
	[ "$bad" = 0 ] || exit 2
	files=$rel
fi
if [ "$scope" = "--message" ] && [ ! -r "$msgfile" ]; then
	echo "check-identities: $msgfile is not a readable file" >&2
	exit 2
fi

[ -n "$files" ] || [ "$scope" = "--message" ] || { echo "check-identities: nothing to check"; exit 0; }

# Text only: a texture is not going to name anybody, and grep on a jpeg is
# noise.
text=""
for f in $files; do
	case "$f" in
	*.png|*.jpg|*.jpeg|*.jp2|*.gz|*.pdf) continue ;;
	# Generated dependency hashes, where a short handle matches inside
	# base64 and means nothing.
	go.sum|*/go.sum) continue ;;
	esac
	[ -f "$root/$f" ] && text="$text $root/$f"
done
if [ "$scope" = "--message" ]; then
	text=$msgfile
	idfiles=$msgfile
else
	idfiles=""
	for f in $files; do
		case "$f" in go.sum|*/go.sum) continue ;; esac
		[ -f "$root/$f" ] && idfiles="$idfiles $root/$f"
	done
fi
# No text is not nothing to check: a binary or an image on its own is still
# checked below, and the text checks are given an empty file to read rather
# than the standard input a grep with no files would wait on.
[ -n "$text" ] || text=/dev/null

# Nothing compiled belongs in the repository.  A Go binary also carries
# whatever string constants the source had when it was built, so it is a copy
# of the tree that no sweep of the tree can reach -- see CLAUDE.md.
compiled=0
for f in $files; do
	p=$root/$f
	[ -f "$p" ] || continue
	desc=$(file -b "$p" 2>/dev/null)
	# A shell script is "text executable" and is not what this is for.
	case $desc in *text*) continue ;; esac
	case $desc in
	*executable*|*"Mach-O"*|*"ELF "*|*archive*)
		if [ "$compiled" -eq 0 ]; then
			echo "check-identities: this is a compiled binary and cannot be committed:"
			echo
		fi
		compiled=1
		printf '  %s\n' "$f"
		;;
	esac
done
if [ "$compiled" -ne 0 ]; then
	cat <<'BIN'

Add its name to .gitignore -- under /cmd/*/ if it is built beside its source,
and in the root list if it is built by path -- and take it out of the change.
A binary committed once stays in the history for as long as the history does.
BIN
	failed=1
fi

# An image carries more than its pixels: a screenshot or a photograph keeps
# the machine, the software, the time and sometimes the place in text
# chunks, Exif and XMP.  tools/scan-images reads PNG, JPEG, GIF and WebP by
# their content and names what each carries beyond what drawing it needs.
# What the pixels show is not something it can see; that is read by hand.
# See doc/identities.md.
if [ -n "$idfiles" ]; then
	images=$("$root/tools/scan-images" --check $idfiles 2>&1 || true)
	if [ -n "$images" ]; then
		echo "check-identities: these images carry metadata, which can name the machine,"
		echo "the software, the time or the place they were made:"
		echo
		printf '%s\n' "$images" | sed "s|^$root/|  |"
		cat <<'IMG'

Strip it with "exiftool -all= FILE" (or write the image again with Go's
encoders, which add none), and look at what the picture itself shows.
IMG
		failed=1
	fi
fi

# A simulator's address says which machine a real region was running on.
# It needs no list to recognise: anything outside the ranges set aside for
# loopback, private networks and documentation is somebody's real host.
# This is here because three of them reached a published page once, inside a
# transcript that had had its names replaced and its addresses left alone.
addrs=$(grep -RIonE '(^|[^0-9.])([0-9]{1,3}\.){3}[0-9]{1,3}([^0-9.]|$)' $text 2>/dev/null |
	grep -vE '(:|^)[^0-9]*(127\.|0\.0\.0\.0|255\.255|10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|169\.254\.|203\.0\.113\.|198\.51\.100\.|192\.0\.2\.|224\.|239\.|1\.2\.3\.4)' |
	grep -vE '[0-9]{4,}' |
	grep -viE 'version|channel|firestorm' || true)
if [ -n "$addrs" ]; then
	echo "check-identities: this carries real network addresses:"
	echo
	printf '%s\n' "$addrs" | sed "s|^$root/||" | sort -u | while IFS= read -r hit; do
		printf '  %s\n' "$hit"
	done
	cat <<'ADDR'

Use the documentation range instead -- 203.0.113.0/24, 198.51.100.0/24 or
192.0.2.0/24 -- and say in the text that the address is invented.  A region
moves between machines, so the number was only ever true of one moment.
ADDR
	failed=1
fi

# Every 128-bit value has to show that it is not somebody's, and this needs
# no list.  An invented uuid, password digest, mac or id0 carries the
# signature xxxx7e57-7e57-c0de-xxxx-xxxxxxxxxxxx (a digest, mac or id0 is the
# same without the hyphens), and an id written down elided -- ab3f7e57-... --
# has a first group ending in 7e57.  The only others allowed are Linden Lab's
# published constants in tools/known-uuids, and the one digest a test works
# out from a string in tools/known-hashes.  There is no other exception: a
# checker cannot tell a real id from a convincing invention, which is exactly
# why the invention has to say so.  tools/scan-ids knows every shape an id is
# written in and finds each one; doc/identities.md lists them.
if [ -n "$idfiles" ]; then
	# shellcheck disable=SC2086
	unsigned=$("$root/tools/scan-ids" --check $idfiles 2>&1 || true)
	if [ -n "$unsigned" ]; then
		echo "check-identities: these identifiers are neither signed as invented nor known:"
		echo
		printf '%s\n' "$unsigned" | while IFS= read -r hit; do
			printf '  %s\n' "$hit"
		done
		cat <<'UUID'

An invented identifier carries the signature, and tools/new-id makes one:

    $ tools/new-id
    ab3f7e57-7e57-c0de-9d41-6c2e08f1b7a5

Four digits and 7e57, then 7e57-c0de, then the rest.  A password digest, a
login's mac or id0 is the same thing without the hyphens.  An id elided to
its first group is written ab3f7e57-... and shows it was invented.  Nothing
of a real one is kept, and nothing is exempt: a placeholder is signed too.
A uuid of Linden Lab's own -- a built-in animation, a standard texture, the
null key -- goes in tools/known-uuids with where it is published.  Nothing
that names a resident, a region, an object or a group is ever real here.
CLAUDE.md and doc/identities.md have the whole of it.
UUID
		failed=1
	fi
fi

# Tags are part of what is published, and a name or a message there is
# written down as much as a file is.
if [ "$scope" = "--all" ]; then
	tagtext=$(mktemp)
	git for-each-ref --format='%(refname:short)%0a%(contents)' refs/tags > "$tagtext" 2>/dev/null || true
	unsigned=$("$root/tools/scan-ids" --check "$tagtext" 2>&1 | sed "s|^.*$(basename "$tagtext")|tags|" || true)
	rm -f "$tagtext"
	if [ -n "$unsigned" ]; then
		echo "check-identities: a tag's name or message holds an identifier that is not signed:"
		echo
		printf '%s\n' "$unsigned" | while IFS= read -r hit; do
			printf '  %s\n' "$hit"
		done
		failed=1
	fi
fi

# A region's grid square is one map lookup from its name, so a square is
# marked the way a uuid is: both coordinates of an invented one have the
# high byte 0xAA, 43520 to 43775.  A placeholder has both below 16.  A real
# one is a Linden sandbox's and is written down, with where it was seen, in
# tools/known-squares.  This needs no list either.  It reads the square out
# of each form a handle is written in: RegionHandle(x, y), the decimal
# handle, the handle in hex -- a constant, or its eight bytes spaced or
# not, or as a Go byte list -- and the eight bytes as LLSD's base64.  A bare
# (x, y) is not looked for; too many pairs of numbers are something else.
knownsq=$root/tools/known-squares
squares=$(perl -MMIME::Base64 -e '
	my %known;
	if (open my $k, "<", shift @ARGV) {
		while (<$k>) {
			next if /^\s*(#|$)/;
			my ($x, $y) = split /\s+/;
			$known{"$x,$y"} = 1;
		}
	}
	sub ok {
		my ($x, $y) = @_;
		return 1 if $x >> 8 == 0xaa && $y >> 8 == 0xaa;
		return 1 if $x < 16 && $y < 16;
		return $known{"$x,$y"};
	}
	# The square a handle names, or nothing if it is not shaped like one:
	# each half a whole number of 256-metre regions, and each coordinate
	# at least one and inside the sixteen bits the map gives it.
	sub square {
		my ($hi, $lo) = @_;
		return if $hi % 256 || $lo % 256;
		my ($x, $y) = ($hi / 256, $lo / 256);
		return if $x < 1 || $y < 1 || $x > 0xffff || $y > 0xffff;
		return ($x, $y);
	}
	sub halves { my $h = shift; return ($h >> 32, $h & 0xffffffff) }
	for my $f (@ARGV) {
		next if $f =~ m{/tools/known-squares$};
		open my $in, "<", $f or next;
		while (my $line = <$in>) {
			my @sq;
			while ($line =~ /RegionHandle\(\s*(\d+)\s*,\s*(\d+)\s*\)/g) {
				push @sq, ["RegionHandle($1, $2)", $1, $2];
			}
			# The smallest handle, (1, 1), has thirteen digits and
			# the largest, (65535, 65535), seventeen.
			while ($line =~ /(?<![\w.])(\d{13,17})(?![\w]|\.\d)/g) {
				my $n = $1;
				push @sq, [$n, square(halves($n))];
			}
			while ($line =~ /(?<![\w])(0[xX]0*([0-9a-fA-F]{11,14}))(?![\w])/g) {
				my $n = $1;
				push @sq, [$n, square(halves(hex $2))];
			}
			while ($line =~ /(?<![0-9a-fA-FxX])(?=((?:[0-9a-fA-F]{2}[ :]?){7}[0-9a-fA-F]{2})(?![0-9a-fA-F]))/g) {
				my $s = $1;
				(my $h = $s) =~ s/[ :]//g;
				push @sq, [$s, square(hex substr($h, 0, 8), hex substr($h, 8, 8))]
					if $h =~ /^00.{4}0000.{4}00$/;
			}
			while ($line =~ /(?=((?:0[xX][0-9a-fA-F]{1,2}\s*,\s*){7}0[xX][0-9a-fA-F]{1,2})(?![0-9a-fA-F]))/g) {
				my $s = $1;
				my @b = map { hex } $s =~ /0[xX]([0-9a-fA-F]{1,2})/g;
				push @sq, ["{$s}", square(($b[0] << 24 | $b[1] << 16 | $b[2] << 8 | $b[3]),
					($b[4] << 24 | $b[5] << 16 | $b[6] << 8 | $b[7]))]
					if !$b[0] && !$b[3] && !$b[4] && !$b[7];
			}
			while ($line =~ /(?<![A-Za-z0-9+\/])([A-Za-z0-9+\/]{11}=)(?![A-Za-z0-9+\/=])/g) {
				my $s = $1;
				push @sq, [$s, square(unpack "N2", decode_base64($s))];
			}
			for (@sq) {
				my ($what, $x, $y) = @$_;
				next unless defined $y;
				print "$f:$.: $what is square ($x, $y)\n" unless ok($x, $y);
			}
		}
	}
' "$knownsq" $text)
if [ -n "$squares" ]; then
	echo "check-identities: these grid squares are neither marked as invented nor known:"
	echo
	printf '%s\n' "$squares" | sed "s|^$root/||" | while IFS= read -r hit; do
		printf '  %s\n' "$hit"
	done
	cat <<'SQUARE'

An invented square says so: both coordinates have the high byte 0xAA, 43520
to 43775 in decimal.  When it replaces a real one, a region and its
neighbours move together, and every form -- the pair, RegionHandle(x, y), the
decimal handle, its bytes -- is worked out again from the invented square
rather than edited by hand.  A placeholder has both coordinates below 16.  A
real square of one of Linden Lab's public sandboxes goes in
tools/known-squares with where it was observed.  CLAUDE.md has the whole of
it.
SQUARE
	failed=1
fi

# A name is words, and nothing can tell a real one from an invented one, so
# every name the tree uses is written down in tools/known-names and one that
# is not there is refused.  Only the places where a name is plainly a name
# are read -- tools/scan-names and doc/identities.md say which -- and prose
# is left to the person reading it and to the list kept off the tree below.
if [ "$scope" != "--message" ] && [ -n "$idfiles" ]; then
	# shellcheck disable=SC2086
	unlisted=$("$root/tools/scan-names" --check $idfiles 2>&1 || true)
	if [ -n "$unlisted" ]; then
		echo "check-identities: these names are not on tools/known-names:"
		echo
		printf '%s\n' "$unlisted" | while IFS= read -r hit; do
			printf '  %s\n' "$hit"
		done
		cat <<'NAMES'

Every name in this repository is invented and is listed in tools/known-names.
Take a fresh one from the spares at the end of that file (and make a new
spare), or invent one that is not a real resident, region, parcel, group or
object, and add it under its kind with a line saying what it is.  An example
uses the Example family (Example Resident, Example Builders, ...).  Never
add a name because it is in a capture: that is the real thing, and what goes
in a file is an equivalent made up for the purpose.  CLAUDE.md and
doc/identities.md have the whole of it.
NAMES
		failed=1
	fi
fi

found=0
list=$map
[ "$haslist" -eq 1 ] || list=/dev/null
# Read the list, skipping comments and blank lines.  A uuid is also looked for
# by its first eight characters, because the documentation elides them that way
# -- eight characters of somebody's id is still theirs.
while IFS="$(printf '\t')" read -r real repl; do
	case "$real" in ''|\#*) continue ;; esac
	[ -n "$repl" ] || continue

	# The whole string first.  Not word-split into its parts: "Pelmar Reach"
	# is one name, and looking for "Pelmar" and "Reach" separately reports
	# the same line twice and matches things that are neither.
	report() {   # $1 hits, $2 what to write instead, $3 what was found
		[ -n "$1" ] || return 0
		if [ "$found" -eq 0 ]; then
			echo "check-identities: this names real people or places:"
			echo
		fi
		found=1
		printf '%s\n' "$1" | sed "s|^$root/||" | sort -u | while IFS= read -r hit; do
			printf '  %s\n' "$hit"
		done
		printf '      ^ write %s instead of %s\n\n' "$2" "$3"
	}

	hits=$(grep -RIniF -- "$real" $text 2>/dev/null || true)
	report "$hits" "$repl" "$real"

	# The same name written with its punctuation as HTML entities.  A
	# parcel called "Rue&Reed" is "Rue&amp;Reed" in the guide, and a
	# grep for the literal walks straight past it -- which is how one
	# real name survived a scrub of this repository.
	case $real in
	*[\&\'\"\<\>]*)
		entity=$(printf '%s' "$real" |
			sed -e 's/&/\&amp;/g' -e "s/'/\&#39;/g" -e 's/"/\&quot;/g' \
			    -e 's/</\&lt;/g' -e 's/>/\&gt;/g')
		hits=$(grep -RIniF -- "$entity" $text 2>/dev/null || true)
		report "$hits" "$repl" "$entity"
		;;
	esac

	# A uuid is also elided to its first eight characters in the
	# documentation, and eight characters of somebody's id is still theirs.
	# Not when more hex follows, or a placeholder of repeated nibbles
	# matches every other placeholder.
	case "$real" in
	*-*-*-*-*)
		short=$(printf '%s' "$real" | cut -c1-8)
		hits=$(grep -RIniE -- "$short([^0-9a-fA-F]|$)" $text 2>/dev/null |
			grep -viF -- "$real" || true)
		report "$hits" "$(printf '%s' "$repl" | cut -c1-8)" "$short"
		;;
	esac
done < "$list"

if [ "$found" -ne 0 ]; then
	cat <<'WHY'
Nothing that identifies a real resident, their land, their objects or their
groups belongs in this repository, which is public.  Invent a name, and make
every uuid with tools/new-id so that it carries the signature.  CLAUDE.md has
the whole of it.

If one of these is a false positive -- an ordinary word that happens to match
-- the answer is to make the entry in the list more specific rather than to
skip the check.
WHY
	failed=1
fi

if [ "$failed" -ne 0 ]; then
	exit 1
fi
echo "check-identities: nothing real in what was checked"
